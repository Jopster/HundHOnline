<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_hh_article_list" model="ir.ui.view">
        <field name="name">hh.article.list</field>
        <field name="model">hh.article</field>
        <field name="arch" type="xml">
            <list string="Artikelliste" create="1" edit="1">
                <field name="article_number"/>
                <field name="name"/>
                <field name="article_type"/>
                <field name="category_id"/>
                <field name="stock_quantity"/>
                <field name="sale_price"/>
                <field name="purchase_price"/>
                <field name="unit_name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_product_template_hh_article_search" model="ir.ui.view">
        <field name="name">hh.article.search</field>
        <field name="model">hh.article</field>
        <field name="arch" type="xml">
            <search string="Artikel suchen">
                <field name="article_number"/>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('article_number', 'ilike', self)]"/>
                <field name="category_id"/>
                <filter name="active" string="Aktive Artikel" domain="[('active', '=', True)]"/>
                <filter name="favorites" string="Favoriten" domain="[('is_favorite', '=', True)]"/>
                <filter name="webshop" string="Im WebShop" domain="[('webshop', '=', True)]"/>
                <filter name="articles" string="Artikel" domain="[('article_type', '=', 'article')]"/>
                <filter name="texts" string="Texte" domain="[('article_type', '=', 'text')]"/>
                <group expand="0" string="Gruppieren nach">
                    <filter name="group_category" string="Warengruppe" context="{'group_by': 'category_id'}"/>
                </group>
                <searchpanel>
                    <field name="category_id" select="multi" hierarchy="1" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="view_product_template_hh_article_form" model="ir.ui.view">
        <field name="name">hh.article.form</field>
        <field name="model">hh.article</field>
        <field name="arch" type="xml">
            <form string="Artikeldaten">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Artikelbezeichnung"/></h1>
                    </div>
                    <group>
                        <group string="Definition">
                            <field name="article_number"/>
                            <field name="article_type"/>
                            <field name="category_id"/>
                            <field name="property_type"/>
                            <field name="unit_name"/>
                            <field name="active"/>
                            <field name="is_favorite"/>
                            <field name="is_hidden"/>
                            <field name="webshop"/>
                            <field name="report_visible"/>
                        </group>
                        <group string="Preis">
                            <field name="sale_price"/>
                            <field name="purchase_price"/>
                            <field name="sale_tax_rate"/>
                            <field name="purchase_tax_rate"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Artikel">
                            <group string="Beschreibung">
                                <field name="description" placeholder="Beschreibung"/>
                                <field name="long_description"/>
                            </group>
                            <group string="Abmessungen / Gewichte">
                                <field name="length"/>
                                <field name="width"/>
                                <field name="thickness"/>
                                <field name="volume"/>
                                <field name="weight"/>
                                <field name="waste_allowance"/>
                            </group>
                        </page>
                        <page string="Lieferanten">
                            <field name="supplier_ids">
                                <list editable="bottom">
                                    <field name="is_primary"/>
                                    <field name="partner_id"/>
                                    <field name="price"/>
                                    <field name="minimum_quantity"/>
                                    <field name="packaging_unit"/>
                                    <field name="delivery_days"/>
                                    <field name="supplier_product_code"/>
                                </list>
                                <form string="Lieferantendaten">
                                    <group>
                                        <field name="partner_id"/>
                                        <field name="is_primary"/>
                                        <field name="price"/>
                                        <field name="minimum_quantity"/>
                                        <field name="packaging_unit"/>
                                        <field name="delivery_days"/>
                                        <field name="supplier_product_code"/>
                                        <field name="order_text"/>
                                        <field name="note"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Lager">
                            <group>
                                <field name="stock_quantity" readonly="1"/>
                                <field name="min_stock_quantity" readonly="1"/>
                            </group>
                            <field name="stock_ids">
                                <list editable="bottom">
                                    <field name="warehouse_name"/>
                                    <field name="location_name"/>
                                    <field name="quantity"/>
                                    <field name="minimum_quantity"/>
                                </list>
                            </field>
                        </page>
                        <page string="Zeichnung/Bilder">
                            <group><field name="image_1920" widget="image" class="oe_avatar"/></group>
                        </page>
                        <page string="Dokumente">
                            <group><field name="document_notes" placeholder="Dokumenthinweise und Verweise"/></group>
                        </page>
                        <page string="Zeiten">
                            <group>
                                <field name="total_minutes" readonly="1"/>
                                <field name="total_time_cost" readonly="1"/>
                            </group>
                            <field name="time_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="minutes"/>
                                    <field name="work_type"/>
                                    <field name="cost"/>
                                </list>
                            </field>
                        </page>
                        <page string="Auswertung">
                            <group string="Auswertung für diesen Artikel">
                                <field name="project_count"/>
                                <field name="document_count"/>
                                <field name="invoice_count"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hh_articles" model="ir.actions.act_window">
        <field name="name">Artikel/Texte</field>
        <field name="res_model">hh.article</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="search_view_id" ref="view_product_template_hh_article_search"/>
    </record>
</odoo>