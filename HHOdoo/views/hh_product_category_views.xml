<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hh_product_category_list" model="ir.ui.view">
        <field name="name">hh.product.category.list</field>
        <field name="model">hh.product.category</field>
        <field name="arch" type="xml">
            <list string="Warengruppen">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="product_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hh_product_category_form" model="ir.ui.view">
        <field name="name">hh.product.category.form</field>
        <field name="model">hh.product.category</field>
        <field name="arch" type="xml">
            <form string="Warengruppe">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="fa-cube">
                            <field name="product_count" widget="statinfo" string="Artikel"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hh_product_categories" model="ir.actions.act_window">
        <field name="name">Warengruppen</field>
        <field name="res_model">hh.product.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>