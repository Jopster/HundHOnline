<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_hh_odoo" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.hh.odoo</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="HHOnline" name="hh_odoo" groups="base.group_system">
                    <block title="Globale Eigenschaften">
                        <setting string="Dokumentenpfad" help="Basisverzeichnis für H&amp;H-Dokumente.">
                            <field name="hh_document_path" placeholder="z. B. /srv/hh-documents"/>
                        </setting>
                        <setting string="Wartungsmodus" help="Kennzeichnet die H&amp;H-Funktionen als in Wartung.">
                            <field name="hh_maintenance_mode"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>