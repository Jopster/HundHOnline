<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_hh_projects" model="ir.actions.act_window">
        <field name="name">Projekte</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'default_hh_status': 'draft'}</field>
    </record>

    <record id="action_hh_dashboard" model="ir.actions.client">
        <field name="name">HHOnline</field>
        <field name="tag">hh_odoo.dashboard</field>
    </record>

    <menuitem id="menu_hh_odoo_root" name="HHOnline" action="action_hh_dashboard" sequence="1"/>
    <menuitem id="menu_hh_hotkeys" name="Hotkeys" parent="menu_hh_odoo_root" action="action_hh_dashboard" sequence="1"/>
    <menuitem id="menu_hh_terminmanager" name="Terminmanager" parent="menu_hh_odoo_root" action="action_hh_project_events" sequence="2"/>
    <menuitem id="menu_hh_windows" name="Fenster" parent="menu_hh_odoo_root" action="action_hh_dashboard" sequence="3"/>
    <menuitem id="menu_hh_system" name="System" parent="menu_hh_odoo_root" action="base_setup.action_general_configuration" groups="base.group_system" sequence="4"/>
    <menuitem id="menu_hh_help" name="Hilfe" parent="menu_hh_odoo_root" action="action_hh_dashboard" sequence="5"/>
</odoo>